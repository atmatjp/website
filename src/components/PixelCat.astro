---
// icon.jpg (32x32 ドット絵) を CSS グラデーションで再現
// 1 行 = 1 レイヤー。各行は 2 ドット分の高さで描き、下の行を上に重ねて
// 小数倍率 (125% 表示など) でも行間に継ぎ目が出ないようにしている
---

<div class="pixel-cat" role="img" aria-label="adam"></div>

<style>
  .pixel-cat {
    --dot: calc(100px / 32);
    width: calc(var(--dot) * 32);
    height: calc(var(--dot) * 32);
    background-repeat: no-repeat;
    background-size: 100% calc(var(--dot) * 2);
    background-position:
      0 calc(31 * var(--dot)),
      0 calc(30 * var(--dot)),
      0 calc(29 * var(--dot)),
      0 calc(28 * var(--dot)),
      0 calc(27 * var(--dot)),
      0 calc(26 * var(--dot)),
      0 calc(25 * var(--dot)),
      0 calc(24 * var(--dot)),
      0 calc(23 * var(--dot)),
      0 calc(22 * var(--dot)),
      0 calc(21 * var(--dot)),
      0 calc(20 * var(--dot)),
      0 calc(19 * var(--dot)),
      0 calc(18 * var(--dot)),
      0 calc(17 * var(--dot)),
      0 calc(16 * var(--dot)),
      0 calc(15 * var(--dot)),
      0 calc(14 * var(--dot)),
      0 calc(13 * var(--dot)),
      0 calc(12 * var(--dot)),
      0 calc(11 * var(--dot)),
      0 calc(10 * var(--dot)),
      0 calc(9 * var(--dot)),
      0 calc(8 * var(--dot)),
      0 calc(7 * var(--dot)),
      0 calc(6 * var(--dot)),
      0 calc(5 * var(--dot)),
      0 calc(4 * var(--dot)),
      0 calc(3 * var(--dot)),
      0 calc(2 * var(--dot)),
      0 calc(1 * var(--dot)),
      0 calc(0 * var(--dot));
    background-image:
      linear-gradient(#1b64b5, #1b64b5),
      linear-gradient(90deg, #1b64b5 0% 81.25%, #fff 81.25% 84.375%, #1b64b5 84.375% 100%),
      linear-gradient(90deg, #1b64b5 0% 78.125%, #fff 78.125% 87.5%, #1b64b5 87.5% 100%),
      linear-gradient(90deg, #1b64b5 0% 81.25%, #fff 81.25% 84.375%, #1b64b5 84.375% 100%),
      linear-gradient(#1b64b5, #1b64b5),
      linear-gradient(90deg, #1b64b5 0% 40.625%, #fff 40.625% 43.75%, #1b64b5 43.75% 100%),
      linear-gradient(#1b64b5, #1b64b5),
      linear-gradient(#1b64b5, #1b64b5),
      linear-gradient(#1b64b5, #1b64b5),
