      linear-gradient(90deg, #1b64b5 0% 9.375%, #484849 9.375% 15.625%, #d1d1d1 15.625% 21.875%, #484849 21.875% 25%, #d1d1d1 25% 46.875%, #484849 46.875% 50%, #d1d1d1 50% 65.625%, #484849 65.625% 68.75%, #d1d1d1 68.75% 71.875%, #484849 71.875% 75%, #d1d1d1 75% 78.125%, #484849 78.125% 81.25%, #d1d1d1 81.25% 90.625%, #484849 90.625% 93.75%, #1b64b5 93.75% 100%),
