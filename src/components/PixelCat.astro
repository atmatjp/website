      linear-gradient(90deg, #1b64b5 0% 53.125%, #484849 53.125% 59.375%, #1b64b5 59.375% 81.25%, #484849 81.25% 87.5%, #1b64b5 87.5% 100%),
      linear-gradient(#1b64b5, #1b64b5),
      linear-gradient(90deg, #1b64b5 0% 43.75%, #fff 43.75% 46.875%, #1b64b5 46.875% 100%),
      linear-gradient(#1b64b5, #1b64b5),
      linear-gradient(90deg, #1b64b5 0% 75%, #fff 75% 78.125%, #1b64b5 78.125% 100%),
      linear-gradient(90deg, #1b64b5 0% 71.875%, #fff 71.875% 81.25%, #1b64b5 81.25% 100%),
      linear-gradient(90deg, #1b64b5 0% 75%, #fff 75% 78.125%, #1b64b5 78.125% 100%),
